script/source = "extends VLCMediaPlayer


var dragging = false
var error_count = 0
# The one request in flight, if any, held on purpose: dropping a request is what cancels it, so a
# request kept only in a local is destroyed by the time its answer arrives -- and libvlc answers
# that with a null picture.
var thumbnail_request: VLCThumbnailRequest = null
var loop_a = -1
var video_tracks: Array[VLCTrack]
var audio_tracks: Array[VLCTrack]
var text_tracks: Array[VLCTrack]


func _ready() -> void:
	# Static calls, and the only line in the panel that answers which VLC this is:
	# the runtime's version and the revision it was built from, which is what a bug
	# report needs and what build/vlc/vlc.lock pins.
	%VLCVersion.text = \"libvlc: %s (%s)\" % [VLCInstance.get_version(), VLCInstance.get_changeset()]


func _process(_delta: float) -> void:
	var state = get_state()
	var state_text = \"\"
	match state:
		STATE_BUFFERING: state_text = \"buffering\"
		STATE_ERROR: state_text = \"error\"
		STATE_NOTHING_SPECIAL: state_text = \"noting special\"
		STATE_OPENING: state_text = \"openning\"
		STATE_PAUSED: state_text = \"paused\"
		STATE_PLAYING: state_text = \"playing\"
		STATE_STOPPED :state_text = \"stopped\"
		STATE_STOPPING: state_text = \"stopping\"
	%State.text = \"state: \" + state_text
	# The progress display is polled on purpose. get_time() and get_position() are
	# interpolated against the system clock, so they read smoothly at whatever rate
	# this runs at; time_changed/position_changed are paced by libvlc instead and
	# arrive only a few times a second.
	%Time.text = \"time: {0} / {1}\".format([get_time(), get_length()])
	var pos = get_position()
	%Position.text = \"position: %.6f\" % pos
	%GPUOutput.text = \"gpu output: \" + str(is_gpu_output_active())
	if %TimeWatch/Watch.button_pressed:
		# The interpolated clock, read every frame: libvlc reports points at the output's
		# own pace, and interpolate_time_point() advances the newest of them to now.
		var watched: Dictionary = interpolate_time_point()
		%TimeWatch/Clock.text = \"clock: %.3f s\" % (watched[\"ts_us\"] / 1000000.0)
	_update_loop_label()
	if not dragging:
		%HSlider.value = pos


func _on_seekable_changed(seekable: bool) -> void:
	%HSlider.editable = seekable


func _on_play_pressed() -> void:
	play()


func _on_pause_pressed() -> void:
	set_pause(true)


func _on_resume_pressed() -> void:
	set_pause(false)


func _on_stop_pressed() -> void:
	stop_async()
	


func _on_set_a_pressed() -> void:
	# libvlc sets the loop in one call, so the panel holds the first time until the
	# second button is pressed. The loop belongs to the input: Stop ends it, and
	# this label goes back to \"none\" with it.
	loop_a = get_time()


func _on_set_b_pressed() -> void:
	if loop_a < 0:
		return
	set_abloop_time(loop_a, get_time())
	loop_a = -1


func _on_reset_loop_pressed() -> void:
	reset_abloop()


func _on_jump_back_pressed() -> void:
	# A relative seek: libvlc adds the delta to its own current time, so this does not
	# need to read the clock first. It answers 0 whatever happens, including a jump
	# past the end, which ends playback rather than being refused.
	jump_time(-10000)


func _on_jump_forward_pressed() -> void:
	jump_time(10000)


func _on_audio_delay_value_changed(value: float) -> void:
	# The control counts milliseconds and the API counts microseconds, which is the
	# difference between this method and the `audio-desync` option that writes the same
	# value. The delay belongs to the input: before one exists the call is accepted and
	# dropped, so this only has an effect once something is playing.
	set_audio_delay_us(int(value * 1000.0))


func _on_time_watch_toggled(pressed: bool) -> void:
	# libvlc allows one watcher per player and fails a second registration; the binding
	# answers -1 for that without asking it, so this only has to handle its own button.
	if pressed:
		if watch_time(0) != 0:
			%TimeWatch/Watch.set_pressed_no_signal(false)
	else:
		unwatch_time()


func _update_loop_label() -> void:
	# Polled rather than driven by a signal: libvlc raises no event when a loop is
	# set, cleared or entered, and none when it wraps either. The status alone
	# answers whether there is a loop, so the dictionary is only built when there
	# is something to show.
	if loop_a >= 0:
		%Loop.text = \"loop: a=%d (pick b)\" % loop_a
		return
	var status := get_abloop_status()
	if status == ABLOOP_NONE:
		%Loop.text = \"loop: none\"
		return
	var loop := get_abloop()
	if status == ABLOOP_A:
		%Loop.text = \"loop: a=%d, no b\" % loop[\"a_time\"]
	elif loop[\"a_time\"] >= 0:
		%Loop.text = \"loop: %d-%d ms\" % [loop[\"a_time\"], loop[\"b_time\"]]
	else:
		%Loop.text = \"loop: %.2f-%.2f\" % [loop[\"a_pos\"], loop[\"b_pos\"]]


func _on_load_pressed() -> void:
	$FileDialog.visible = true


func _on_load_mrl_pressed() -> void:
	if !%InputMRLDialog.visible:
		%InputMRLDialog.popup_centered()


func _on_input_mrl_dialog_confirmed() -> void:
	# The options go onto the media before it is loaded into the player: assigning a
	# media is what creates the input, and that is the only moment libvlc reads them.
	var loaded := VLCMedia.load_from_mrl(%MRL.text)
	if loaded != null:
		for option in %Options.text.split(\",\", false):
			loaded.add_option(option.strip_edges())
	media = loaded
	%InputMRLDialog.hide()
	pass


func _on_h_slider_drag_started() -> void:
	dragging = true


func _on_h_slider_drag_ended(value_changed: bool) -> void:
	if value_changed:
		set_position(%HSlider.value, false)
		dragging = false


func _on_buffering(percent: float) -> void:
	%Buffering.text = \"buffering: %.1f\" % percent


func _on_error() -> void:
	# Sticky on purpose. The state polled in _process() can leave STATE_ERROR
	# before a frame is drawn -- a failed open goes through stopping/stopped --
	# so a label that only showed the current state would rarely show this.
	error_count += 1
	%Error.text = \"error: yes (%d)\" % error_count


# A track's name is a title, and empty for a track that came from the media
# rather than from the player, so the codec and the shape are what tell two
# tracks apart. One helper, so that the three lists read the same way.
func _track_label(track: VLCTrack) -> String:
	var info: Dictionary = track.get_info()
	var label: String = track.get_name()
	if label.is_empty():
		label = track.get_codec_description()
	match info.get(\"type\", VLCTrack.TYPE_UNKNOWN):
		VLCTrack.TYPE_VIDEO:
			label += \" %dx%d\" % [info.get(\"width\", 0), info.get(\"height\", 0)]
		VLCTrack.TYPE_AUDIO:
			label += \" %dch %d Hz\" % [info.get(\"channels\", 0), info.get(\"rate\", 0)]
		VLCTrack.TYPE_TEXT:
			var encoding: String = info.get(\"encoding\", \"\")
			if not encoding.is_empty():
				label += \" (%s)\" % encoding
	return label


func _on_playing() -> void:
	%Media.text = _media_identity()
	%Playlist.text = _playlist_line()
	_refresh_tracks()
	_refresh_chapter_panel()


# The list player hangs off this node -- it plays through the VLCMediaPlayer it is a child
# of -- and the two buttons below drive a queue built from whatever is loaded now: the
# same media twice, which is enough to watch it move on.
func _on_list_play_pressed() -> void:
	if media == null:
		%List.text = \"list: nothing loaded\"
		return
	var queue := VLCMediaList.new()
	queue.add_media(media)
	queue.add_media(media)
	$ListPlayer.set_media_list(queue)
	$ListPlayer.play()


func _on_list_next_pressed() -> void:
	if $ListPlayer.next() != 0:
		%List.text = \"list: no next item\"


func _on_list_item_set(item: VLCMedia) -> void:
	%List.text = \"list item: %s\" % item.get_mrl()


# A thumbnail at the middle of the media, asked for by position: a fraction needs no known
# duration, which is the one thing a panel cannot count on before a parse has run.
#
# Pressing twice ends with exactly one request in flight and one connection on the media: the
# previous connection comes off and the previous request is let go first, because cancelling a
# request makes libvlc answer it from inside the call, and that answer is not this press's.
func _on_thumbnail_request_pressed() -> void:
	if media == null:
		%ThumbnailInfo.text = \"thumbnail: nothing loaded\"
		return
	if media.thumbnail_generated.is_connected(_on_thumbnail_generated):
		media.thumbnail_generated.disconnect(_on_thumbnail_generated)
	thumbnail_request = null
	var request := media.thumbnail_request_by_pos(
		0.5, VLCThumbnailRequest.SEEK_PRECISE, 192, 192, false, VLCPicture.TYPE_PNG, 5000
	)
	if request == null:
		%ThumbnailInfo.text = \"thumbnail: libvlc refused the request\"
		return
	# Held, not dropped: see the field above. The signal is the only way the answer arrives, and a
	# request whose last reference is gone is a request libvlc has cancelled.
	thumbnail_request = request
	media.thumbnail_generated.connect(_on_thumbnail_generated, CONNECT_ONE_SHOT)


func _on_thumbnail_generated(picture: VLCPicture) -> void:
	# The answer has arrived, so the request has done its job and can go; letting it go here is
	# what destroys libvlc's, rather than leaving it on the panel until the next press.
	thumbnail_request = null
	if picture == null:
		%ThumbnailInfo.text = \"thumbnail: none (libvlc reports every failure this way)\"
		return
	var image: Image = picture.to_image()
	if image == null:
		%ThumbnailInfo.text = \"thumbnail: could not be turned into an image\"
		return
	%Thumbnail.texture = ImageTexture.create_from_image(image)
	%ThumbnailInfo.text = \"thumbnail: %dx%d, %d bytes\" % [
		image.get_width(), image.get_height(), picture.get_buffer().size()
	]


# What is inside the media, if it holds anything: a playlist's entries, a disc's titles,
# a directory's files. They show up while it plays -- that is what parses it -- and the
# list is read-only, because it belongs to the media.
func _playlist_line() -> String:
	if media == null:
		return \"playlist:\"
	var subitems := media.get_subitems()
	if subitems == null:
		return \"playlist: (none)\"
	return \"playlist: %d item(s)%s\" % [
		subitems.count(), \" (read-only)\" if subitems.is_read_only() else \"\"
	]


# What is playing: the engine's name for it, libvlc's type, and libvlc's MRL.
# The three disagree on purpose -- a media from res:// answers \"imem://\" to
# get_mrl() whatever file is behind it, and one a script built itself has no
# resource_path at all -- so this line shows both, and the extension's class
# documentation explains which of them names the file.
func _media_identity() -> String:
	if media == null:
		return \"media: none\"
	var kind := \"unknown\"
	match media.get_type():
		VLCMedia.MEDIA_TYPE_FILE: kind = \"file\"
		VLCMedia.MEDIA_TYPE_DIRECTORY: kind = \"directory\"
		VLCMedia.MEDIA_TYPE_DISC: kind = \"disc\"
		VLCMedia.MEDIA_TYPE_STREAM: kind = \"stream\"
		VLCMedia.MEDIA_TYPE_PLAYLIST: kind = \"playlist\"
	var source: String = media.resource_path
	if source.is_empty():
		source = \"(no resource path)\"
	return \"media: %s [%s] %s\" % [source, kind, media.get_mrl()]


# The three lists, rebuilt from the player: when a media opens, and again for every
# track event, because the tracks of a running input change -- a subtitle attached
# while playing is a new track, and libvlc also updates the video track once the
# decoder has reported the stream's format.
#
# Nothing in here answers its own controls: setting an OptionButton's selection or
# an ItemList's does not emit their signals, only a click does.
func _refresh_tracks() -> void:
	var video_list := get_tracklist(VLCTrack.TYPE_VIDEO, false)
	var audio_list := get_tracklist(VLCTrack.TYPE_AUDIO, false)
	var text_list := get_tracklist(VLCTrack.TYPE_TEXT, false)
	video_tracks.clear()
	audio_tracks.clear()
	text_tracks.clear()
	if video_list != null:
		video_tracks.assign(video_list.get_tracks())
	if audio_list != null:
		audio_tracks.assign(audio_list.get_tracks())
	if text_list != null:
		text_tracks.assign(text_list.get_tracks())

	var video_button: OptionButton = %VideoTrack/OptionButton
	var audio_button: OptionButton = %AudioTrack/OptionButton
	var text_items: ItemList = %TextTrack/ItemList
	video_button.clear()
	audio_button.clear()
	text_items.clear()
	video_button.add_item(\"disable\")
	audio_button.add_item(\"disable\")
	for track in video_tracks:
		video_button.add_item(_track_label(track))
	for track in audio_tracks:
		audio_button.add_item(_track_label(track))
	for track in text_tracks:
		text_items.add_item(_track_label(track))

	# The player is asked what is selected, rather than the tracks above: a track's
	# own is_selected() is as old as the list it came from, and libvlc queues a
	# selection, so the two can disagree for a frame.
	var video_selected := get_selected_track(VLCTrack.TYPE_VIDEO)
	if video_selected != null:
		for i in video_tracks.size():
			if video_tracks[i].get_id() == video_selected.get_id():
				video_button.selected = i + 1
	var audio_selected := get_selected_track(VLCTrack.TYPE_AUDIO)
	if audio_selected != null:
		for i in audio_tracks.size():
			if audio_tracks[i].get_id() == audio_selected.get_id():
				audio_button.selected = i + 1
	var text_selected := get_tracklist(VLCTrack.TYPE_TEXT, true)
	if text_selected != null:
		for selected in text_selected.get_tracks():
			for i in text_tracks.size():
				if text_tracks[i].get_id() == selected.get_id():
					text_items.select(i, false)


# Nothing about a chapter is known before something plays: libvlc publishes the chapter
# and title lists with the input, not with the media, so both are empty -- and both
# getters answer -1 -- until playback starts, and both are redrawn whenever libvlc says
# something moved. A media with no chapter list at all is the common case, the movie
# this demo ships with being one of them, so the dropdown says so rather than showing a
# blank row that looks the same as a media whose chapters have not arrived yet.
func _refresh_chapters() -> void:
	var chapter_button: OptionButton = %Chapter/OptionButton
	var chapters := get_full_chapter_descriptions(-1)
	chapter_button.clear()
	if chapters.is_empty():
		chapter_button.add_item(\"(no chapters)\")
		chapter_button.disabled = true
	else:
		chapter_button.disabled = false
		for i in chapters.size():
			chapter_button.add_item(\"%d: %s\" % [i + 1, chapters[i][\"name\"]])
		# Asked of the player, not read off the list: the chapter a media starts on is
		# whatever libvlc selected, and the list itself does not record a selection.
		var current := get_chapter()
		if current >= 0 and current < chapters.size():
			chapter_button.selected = current


# Both halves of the panel, for the events that move either of them. A chapter event
# carries no title index -- libvlc has one and does not send it -- so a chapter change is
# also the moment to re-read which title playback is in.
func _refresh_chapter_panel() -> void:
	_refresh_chapters()
	_refresh_title()


# How many titles the input has and which one it is on. Both getters answer -1 while
# there is no title list, which is what a plain video without a chapter list is: an MP4
# only grows a title list when its chapter table exists.
func _refresh_title() -> void:
	var titles := get_full_title_descriptions()
	var current := get_title()
	if current < 0 or current >= titles.size():
		%CurrentTitle.text = \"title: (none)\"
	else:
		%CurrentTitle.text = \"title: %d/%d %s\" % [current + 1, titles.size(), titles[current][\"name\"]]


# Every track event redraws the lists: the track that changed is the one whose label
# or selection has just gone stale.
func _on_track_changed(_track_type: int, _id: String) -> void:
	_refresh_tracks()


func _on_chapter_changed(_chapter: int) -> void:
	_refresh_chapter_panel()


# libvlc sends this one without a payload on purpose: the list itself has to be asked for
# again, and this is the signal that says it is worth asking.
func _on_title_list_changed() -> void:
	_refresh_chapter_panel()


func _on_title_selection_changed(_index: int, _title: Dictionary) -> void:
	_refresh_chapter_panel()


func _on_stopped() -> void:
	_refresh_chapter_panel()


func _on_chapter_option_button_item_selected(index: int) -> void:
	set_chapter(index)


func _on_video_option_button_item_selected(index: int) -> void:
	if index == 0:
		unselect_track_type(VLCTrack.TYPE_VIDEO)
	else:
		select_track(video_tracks[index - 1])


func _on_audio_option_button_item_selected(index: int) -> void:
	if index == 0:
		unselect_track_type(VLCTrack.TYPE_AUDIO)
	else:
		select_track(audio_tracks[index - 1])


# The text list is where the demo shows the one thing libvlc lets a caller select
# more than one of: up to two subtitles at once. The whole set is handed over,
# because that is what select_tracks means -- it replaces the type's selection
# instead of adding to it, and an empty set is what clears it.
func _on_text_item_list_multi_selected(_index: int, _selected: bool) -> void:
	var text_items: ItemList = %TextTrack/ItemList
	var wanted: Array[VLCTrack] = []
	for i in text_tracks.size():
		if text_items.is_selected(i):
			wanted.append(text_tracks[i])
	select_tracks(VLCTrack.TYPE_TEXT, wanted)


func _on_statics_pressed() -> void:
	var stats = media.get_stats()
	print(stats)


func _on_file_dialog_file_selected(path: String) -> void:
	media = VLCMedia.load_from_file(path)
"

